@model string
@{
	ViewData["Title"] = "Now Playing";
}
<h1>Now Playing</h1>
<h2>Track @ViewBag.Number: @Model</h2> @if ((int)ViewBag.Number > 1) {
<a asp-controller="Playlist" asp-action="Track" asp-route-number="@((int)ViewBag.Number - 1)">Previous</a>
}
 @if ((int)ViewBag.Number < (int)ViewBag.TotalTracks)
{
	<a asp-controller="Playlist" asp-action="Track" asp-route-number="@((int)ViewBag.Number + 1)">Next</a>
}