@model string[]

@{
	ViewData["Title"] = "My Playlist";
}

<h1>My Playlist</h1>

<ol>
	@foreach (var song in Model)
	{
		<li>
			<a asp-controller="Playlist"
			   asp-action="Track"
			   asp-route-number="@((int)Array.IndexOf(Model, song) + 1)">
				@song
			</a>
		</li>

	}
</ol>